</w:r></w:p><w:tbl><w:tblPr><w:tblStyle w:val="PlainTable1"/><w:tblW w:w="5000" w:type="pct"/><w:tblLook w:val="0020" w:firstRow="1" w:lastRow="0" w:firstColumn="0" w:lastColumn="0" w:noHBand="0" w:noVBand="0"/></w:tblPr><w:tblGrid><w:gridCol w:w="1731"/><w:gridCol w:w="9285"/></w:tblGrid><w:tr w:rsidR="00134F10" w14:paraId="6E26210C" w14:textId="77777777" w:rsidTr="0048484D"><w:trPr><w:cnfStyle w:val="100000000000" w:firstRow="1" w:lastRow="0" w:firstColumn="0" w:lastColumn="0" w:oddVBand="0" w:evenVBand="0" w:oddHBand="0" w:evenHBand="0" w:firstRowFirstColumn="0" w:firstRowLastColumn="0" w:lastRowFirstColumn="0" w:lastRowLastColumn="0"/></w:trPr><w:tc><w:tcPr><w:cnfStyle w:val="000010000000" w:firstRow="0" w:lastRow="0" w:firstColumn="0" w:lastColumn="0" w:oddVBand="1" w:evenVBand="0" w:oddHBand="0" w:evenHBand="0" w:firstRowFirstColumn="0" w:firstRowLastColumn="0" w:lastRowFirstColumn="0" w:lastRowLastColumn="0"/><w:tcW w:w="0" w:type="auto"/></w:tcPr><w:p w14:paraId="53C87D87" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/></w:pPr><w:r><w:t>Item</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="0" w:type="auto"/></w:tcPr><w:p w14:paraId="4D847916" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:cnfStyle w:val="100000000000" w:firstRow="1" w:lastRow="0" w:firstColumn="0" w:lastColumn="0" w:oddVBand="0" w:evenVBand="0" w:oddHBand="0" w:evenHBand="0" w:firstRowFirstColumn="0" w:firstRowLastColumn="0" w:lastRowFirstColumn="0" w:lastRowLastColumn="0"/></w:pPr><w:r><w:t>Detail</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00134F10" w14:paraId="6D320A75" w14:textId="77777777" w:rsidTr="0048484D"><w:trPr><w:cnfStyle w:val="000000100000" w:firstRow="0" w:lastRow="0" w:firstColumn="0" w:lastColumn="0" w:oddVBand="0" w:evenVBand="0" w:oddHBand="1" w:evenHBand="0" w:firstRowFirstColumn="0" w:firstRowLastColumn="0" w:lastRowFirstColumn="0" w:lastRowLastColumn="0"/></w:trPr><w:tc><w:tcPr><w:cnfStyle w:val="000010000000" w:firstRow="0" w:lastRow="0" w:firstColumn="0" w:lastColumn="0" w:oddVBand="1" w:evenVBand="0" w:oddHBand="0" w:evenHBand="0" w:firstRowFirstColumn="0" w:firstRowLastColumn="0" w:lastRowFirstColumn="0" w:lastRowLastColumn="0"/><w:tcW w:w="0" w:type="auto"/></w:tcPr><w:p w14:paraId="47CEC451" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/></w:pPr><w:r><w:t>Programme title</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="0" w:type="auto"/></w:tcPr><w:p w14:paraId="624E341C" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:cnfStyle w:val="000000100000" w:firstRow="0" w:lastRow="0" w:firstColumn="0" w:lastColumn="0" w:oddVBand="0" w:evenVBand="0" w:oddHBand="1" w:evenHBand="0" w:firstRowFirstColumn="0" w:firstRowLastColumn="0" w:lastRowFirstColumn="0" w:lastRowLastColumn="0"/></w:pPr><w:r><w:t>Safe Online, Kind Online: Anti-Cyberbullying &amp; Digital Citizenship Programme</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00134F10" w14:paraId="3AA68C54" w14:textId="77777777" w:rsidTr="0048484D"><w:tc><w:tcPr><w:cnfStyle w:val="000010000000" w:firstRow="0" w:lastRow="0" w:firstColumn="0" w:lastColumn="0" w:oddVBand="1" w:evenVBand="0" w:oddHBand="0" w:evenHBand="0" w:firstRowFirstColumn="0" w:firstRowLastColumn="0" w:lastRowFirstColumn="0" w:lastRowLastColumn="0"/><w:tcW w:w="0" w:type="auto"/></w:tcPr><w:p w14:paraId="0EF9D3BF" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/></w:pPr><w:r><w:t>Curriculum link</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="0" w:type="auto"/></w:tcPr><w:p w14:paraId="213CF598" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:cnfStyle w:val="000000000000" w:firstRow="0" w:lastRow="0" w:firstColumn="0" w:lastColumn="0" w:oddVBand="0" w:evenVBand="0" w:oddHBand="0" w:evenHBand="0" w:firstRowFirstColumn="0" w:firstRowLastColumn="0" w:lastRowFirstColumn="0" w:lastRowLastColumn="0"/></w:pPr><w:r><w:t>Social Studies (citizenship, rights and responsibilities, community, ethical behaviour), integrated with Digital Citizenship and ICT</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p w14:paraId="7C5C3602" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:bookmarkStart w:id="1" w:name="background-and-rationale"/><w:bookmarkEnd w:id="0"/><w:r><w:t>2. Background and Rationale</w:t></w:r></w:p><w:p w14:paraId="7890E65C" w14:textId="7EBE394A" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading3"/></w:pPr><w:bookmarkStart w:id="2" w:name="why-this-programme-is-needed-now"/><w:r><w:t xml:space="preserve">2.1 Why this programme is needed </w:t></w:r></w:p><w:p w14:paraId="69E23D19" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="FirstParagraph"/></w:pPr><w:r><w:t>Children in Grades 3–5 (roughly ages 8–11) are already active online. Many use family smartphones, play multiplayer games with built-in chat, join WhatsApp class or family groups, and watch and comment on video platforms – often before they have the maturity, vocabulary or rules to handle unkind behaviour online. Most popular social media platforms set a minimum age of 13, yet younger children frequently use them through a parent’s or sibling’s account.</w:t></w:r></w:p><w:p w14:paraId="274ED4A8" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="BodyText"/></w:pPr><w:r><w:t>National evidence shows the risk is real and largely hidden:</w:t></w:r></w:p><w:p w14:paraId="1640EC14" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r><w:t>A 2021 Telenor Pakistan / Idara-e-Taleem-o-Aaghi (ITA) survey found that about one in five young people in Pakistan (19%) experienced online bullying at least once a week.</w:t></w:r></w:p><w:p w14:paraId="53AD73D6" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r><w:t>A 2026 study by UNICEF Innocenti, ECPAT International and INTERPOL estimated that roughly one in sixteen internet-using children aged 12–17 in Pakistan experienced some form of technology-facilitated sexual exploitation or abuse in a single year, and that more than half of affected children told no one. None reported to formal avenues such as helplines or police.</w:t></w:r></w:p><w:p w14:paraId="4041B7E7" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="FirstParagraph"/></w:pPr><w:r><w:t xml:space="preserve">These older-age findings are the strongest argument for </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>early prevention</w:t></w:r><w:r><w:t>: the habits, values and help-seeking behaviour that protect a teenager are formed in the primary years. Grades 3–5 is the right window to build them, before children receive their own devices and social media accounts.</w:t></w:r></w:p><w:p w14:paraId="3438E69F" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading3"/></w:pPr><w:bookmarkStart w:id="3" w:name="why-grade-5-needs-specific-attention"/><w:bookmarkEnd w:id="2"/><w:r><w:t>2.2 Why Grade 5 needs specific attention</w:t></w:r></w:p><w:p w14:paraId="05F4231A" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="FirstParagraph"/></w:pPr><w:r><w:t>Grade 5 students use school Chromebooks during the school day. This means they already have school accounts, use shared devices, and may communicate or collaborate online as part of learning. The school therefore has a direct duty of care to teach responsible use, account security and reporting, and to make sure parents understand how school devices are managed and how home use connects to school expectations.</w:t></w:r></w:p><w:p w14:paraId="01F35EE9" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading3"/></w:pPr><w:bookmarkStart w:id="4" w:name="why-parents-must-be-involved"/><w:bookmarkEnd w:id="3"/><w:r><w:t>2.3 Why parents must be involved</w:t></w:r></w:p><w:p w14:paraId="708CC88A" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="FirstParagraph"/></w:pPr><w:r><w:t>Most cyberbullying happens outside school hours, on home devices. Parents are the first line of supervision and the first adult a child is likely to tell – but only if the child trusts that they will not be punished or have their device taken away. Many parents are also unsure of the platforms their children use, privacy settings, or what to do when an incident occurs. A school-led session gives parents practical knowledge and creates one consistent message between home and school.</w:t></w:r></w:p><w:p w14:paraId="63F6434E" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading3"/></w:pPr><w:bookmarkStart w:id="5" w:name="legal-and-national-context"/><w:bookmarkEnd w:id="4"/><w:r><w:lastRenderedPageBreak/><w:t>2.4 Legal and national context</w:t></w:r></w:p><w:p w14:paraId="7980EAC3" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Pakistan’s </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Prevention of Electronic Crimes Act (PECA) 2016</w:t></w:r><w:r><w:t xml:space="preserve"> makes online harassment, cyberstalking, sharing a person’s images without consent, and related offences punishable by law.</w:t></w:r></w:p><w:p w14:paraId="61BB3C77" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">In April 2025 the FIA’s Cybercrime Wing was converted into an independent body, the </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>National Cyber Crime Investigation Agency (NCCIA)</w:t></w:r><w:r><w:t xml:space="preserve">. Citizens can report cybercrime on the </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>NCCIA helpline 1799</w:t></w:r><w:r><w:t xml:space="preserve">, and since October 2026 cybercrime complaints made to </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Police Helpline 15</w:t></w:r><w:r><w:t xml:space="preserve"> are routed automatically to the NCCIA.</w:t></w:r></w:p><w:p w14:paraId="670B845C" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="FirstParagraph"/></w:pPr><w:r><w:t>Parents will be informed of these channels for serious cases, while the programme makes clear that most incidents among young children should be resolved through the school’s own anti-bullying procedures.</w:t></w:r></w:p><w:p w14:paraId="3FE1A32D" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading3"/></w:pPr><w:bookmarkStart w:id="6" w:name="benefits-to-the-school"/><w:bookmarkEnd w:id="5"/><w:r><w:t>2.5 Benefits to the school</w:t></w:r></w:p><w:p w14:paraId="4E3DC273" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numPr></w:pPr><w:r><w:t>Fulfils the school’s safeguarding and student welfare responsibilities in the digital space.</w:t></w:r></w:p><w:p w14:paraId="32598C19" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numPr></w:pPr><w:r><w:t>Strengthens the Social Studies curriculum with real-life, applied citizenship learning.</w:t></w:r></w:p><w:p w14:paraId="30605826" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numPr></w:pPr><w:r><w:t>Supports safe and responsible use of the school’s Chromebook programme.</w:t></w:r></w:p><w:p w14:paraId="7B228510" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numPr></w:pPr><w:r><w:t>Builds trust and partnership with parents and demonstrates the school’s commitment to child wellbeing.</w:t></w:r></w:p><w:p w14:paraId="7657C027" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numPr></w:pPr><w:r><w:t>Reduces the time and disruption caused by online disputes that spill over into the classroom.</w:t></w:r></w:p><w:p w14:paraId="1F73966D" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:bookmarkStart w:id="7" w:name="aims-and-objectives"/><w:bookmarkEnd w:id="1"/><w:bookmarkEnd w:id="6"/><w:r><w:t>3. Aims and Objectives</w:t></w:r></w:p><w:p w14:paraId="305E899F" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="FirstParagraph"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Overall aim:</w:t></w:r><w:r><w:t xml:space="preserve"> To help students and parents recognise, prevent and respond to cyberbullying, and to build the habits of a responsible, kind and safe digital citizen.</w:t></w:r></w:p><w:p w14:paraId="35D2712E" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="BodyText"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>By the end of the programme, students will be able to:</w:t></w:r></w:p><w:p w14:paraId="654CB213" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr></w:pPr><w:r><w:t>Explain in their own words what cyberbullying is and how it differs from a disagreement or joke.</w:t></w:r></w:p><w:p w14:paraId="4A585DDD" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr></w:pPr><w:r><w:t>Identify the roles of target, bully and bystander, and choose an upstander action.</w:t></w:r></w:p><w:p w14:paraId="3B15D4C2" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Apply the </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Stop – Block – Save – Tell</w:t></w:r><w:r><w:t xml:space="preserve"> response to unkind online behaviour.</w:t></w:r></w:p><w:p w14:paraId="4F8FD86A" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr></w:pPr><w:r><w:t>Keep personal information private and create strong passwords (Grades 4–5).</w:t></w:r></w:p><w:p w14:paraId="5C6E2E5A" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr></w:pPr><w:r><w:t>Follow the school’s Chromebook and acceptable-use rules (Grade 5).</w:t></w:r></w:p><w:p w14:paraId="09F5165B" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr></w:pPr><w:r><w:t>Relate online kindness to the citizenship values of rights, responsibilities and respect taught in Social Studies.</w:t></w:r></w:p><w:p w14:paraId="1A674481" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="FirstParagraph"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>By the end of the programme, parents will be able to:</w:t></w:r></w:p><w:p w14:paraId="06BBB91F" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="6"/></w:numPr></w:pPr><w:r><w:t>Recognise warning signs that a child may be bullied online or bullying others.</w:t></w:r></w:p><w:p w14:paraId="6AB98CD6" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="6"/></w:numPr></w:pPr><w:r><w:t>Use basic parental controls and privacy settings on phones, tablets, games and video apps.</w:t></w:r></w:p><w:p w14:paraId="6B5CDEE2" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="6"/></w:numPr></w:pPr><w:r><w:t>Respond calmly and supportively when a child reports a problem.</w:t></w:r></w:p><w:p w14:paraId="64DF6894" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="6"/></w:numPr></w:pPr><w:r><w:t>Know the school’s reporting procedure and the official external channels for serious cases.</w:t></w:r></w:p><w:p w14:paraId="69BBE5EE" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="6"/></w:numPr></w:pPr><w:r><w:t>Agree a simple family media plan with their child.</w:t></w:r></w:p><w:p w14:paraId="6870D870" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:bookmarkStart w:id="8" w:name="curriculum-linkage"/><w:bookmarkEnd w:id="7"/><w:r><w:t>4. Curriculum Linkage</w:t></w:r></w:p><w:p w14:paraId="4C2C3FFE" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading3"/></w:pPr><w:bookmarkStart w:id="9" w:name="social-studies"/><w:r><w:t>4.1 Social Studies</w:t></w:r></w:p><w:p w14:paraId="589FBE0D" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="FirstParagraph"/></w:pPr><w:r><w:t>The programme extends the citizenship strand of Social Studies in Grades 3–5 into the digital world:</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblStyle w:val="Table"/><w:tblW w:w="5000" w:type="pct"/><w:tblLook w:val="0020" w:firstRow="1" w:lastRow="0" w:firstColumn="0" w:lastColumn="0" w:noHBand="0" w:noVBand="0"/></w:tblPr><w:tblGrid><w:gridCol w:w="3685"/><w:gridCol w:w="7331"/></w:tblGrid><w:tr w:rsidR="00134F10" w14:paraId="3D86EC6A" w14:textId="77777777" w:rsidTr="00134F10"><w:trPr><w:cnfStyle w:val="100000000000" w:firstRow="1" w:lastRow="0" w:firstColumn="0" w:lastColumn="0" w:oddVBand="0" w:evenVBand="0" w:oddHBand="0" w:evenHBand="0" w:firstRowFirstColumn="0" w:firstRowLastColumn="0" w:lastRowFirstColumn="0" w:lastRowLastColumn="0"/><w:tblHeader/></w:trPr><w:tc><w:tcPr><w:tcW w:w="0" w:type="auto"/></w:tcPr><w:p w14:paraId="034ADD35" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/></w:pPr><w:r><w:t>Social Studies theme</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="0" w:type="auto"/></w:tcPr><w:p w14:paraId="6A14DD9E" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/></w:pPr><w:r><w:t>Digital citizenship extension</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00134F10" w14:paraId="714CBD76" w14:textId="77777777"><w:tc><w:tcPr><w:tcW w:w="0" w:type="auto"/></w:tcPr><w:p w14:paraId="7C286C35" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/></w:pPr><w:r><w:t>Rights and responsibilities of a citizen</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="0" w:type="auto"/></w:tcPr><w:p w14:paraId="35CC14F5" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/></w:pPr><w:r><w:t>Our right to be safe online and our responsibility not to harm others</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00134F10" w14:paraId="1C02244D" w14:textId="77777777"><w:tc><w:tcPr><w:tcW w:w="0" w:type="auto"/></w:tcPr><w:p w14:paraId="280D5C7E" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/></w:pPr><w:r><w:lastRenderedPageBreak/><w:t>Rules and laws in the community</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="0" w:type="auto"/></w:tcPr><w:p w14:paraId="23A214BC" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/></w:pPr><w:r><w:t>School digital rules, platform age limits, and Pakistan’s cybercrime law (in simple terms)</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00134F10" w14:paraId="6972CFE2" w14:textId="77777777"><w:tc><w:tcPr><w:tcW w:w="0" w:type="auto"/></w:tcPr><w:p w14:paraId="193753B3" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/></w:pPr><w:r><w:t>Respect, tolerance and good manners</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="0" w:type="auto"/></w:tcPr><w:p w14:paraId="7A92B691" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/></w:pPr><w:r><w:t>Online etiquette, kind words, respecting differences</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00134F10" w14:paraId="4ECF11B4" w14:textId="77777777"><w:tc><w:tcPr><w:tcW w:w="0" w:type="auto"/></w:tcPr><w:p w14:paraId="749E1100" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/></w:pPr><w:r><w:t>Being a good member of the community</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="0" w:type="auto"/></w:tcPr><w:p w14:paraId="6EFF2F86" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/></w:pPr><w:r><w:t>Being an upstander, helping a friend, reporting harm</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00134F10" w14:paraId="4CB14109" w14:textId="77777777"><w:tc><w:tcPr><w:tcW w:w="0" w:type="auto"/></w:tcPr><w:p w14:paraId="78E70120" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/></w:pPr><w:r><w:t>Communication and media</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="0" w:type="auto"/></w:tcPr><w:p w14:paraId="5123278E" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/></w:pPr><w:r><w:t>Thinking before posting, digital footprint, checking if information is true</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p w14:paraId="4718D6ED" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading3"/></w:pPr><w:bookmarkStart w:id="10" w:name="digital-citizenship-strands-covered"/><w:bookmarkEnd w:id="9"/><w:r><w:t>4.2 Digital Citizenship strands covered</w:t></w:r></w:p><w:p w14:paraId="1EFA2814" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="7"/></w:numPr></w:pPr><w:r><w:t>Online safety and privacy</w:t></w:r></w:p><w:p w14:paraId="7DE042E8" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="7"/></w:numPr></w:pPr><w:r><w:t>Relationships and communication</w:t></w:r></w:p><w:p w14:paraId="1F73AE9A" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="7"/></w:numPr></w:pPr><w:r><w:t>Cyberbullying, drama and hate speech</w:t></w:r></w:p><w:p w14:paraId="33FE0836" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="7"/></w:numPr></w:pPr><w:r><w:t>Digital footprint and identity</w:t></w:r></w:p><w:p w14:paraId="338DD749" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="7"/></w:numPr></w:pPr><w:r><w:t>Media literacy (introductory, Grade 5)</w:t></w:r></w:p><w:p w14:paraId="1310ABE9" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:bookmarkStart w:id="11" w:name="guiding-principles"/><w:bookmarkEnd w:id="8"/><w:bookmarkEnd w:id="10"/><w:r><w:t>5. Guiding Principles</w:t></w:r></w:p><w:p w14:paraId="019FCD02" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="8"/></w:numPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Age-appropriate and positive:</w:t></w:r><w:r><w:t xml:space="preserve"> Messages focus on kindness, safety and asking for help. No frightening images, real case details or graphic content.</w:t></w:r></w:p><w:p w14:paraId="6A888484" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="8"/></w:numPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Help-seeking first:</w:t></w:r><w:r><w:t xml:space="preserve"> Children should leave believing that telling a trusted adult is always the right choice, and they will not be blamed or lose their device for telling.</w:t></w:r></w:p><w:p w14:paraId="12509E0A" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="8"/></w:numPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Home–school partnership:</w:t></w:r><w:r><w:t xml:space="preserve"> Parents and students hear the same message and the same simple steps.</w:t></w:r></w:p><w:p w14:paraId="39CB9BA8" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="8"/></w:numPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Inclusive:</w:t></w:r><w:r><w:t xml:space="preserve"> Materials in English and Urdu; seating and support for parents with limited digital experience.</w:t></w:r></w:p><w:p w14:paraId="531F5472" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="8"/></w:numPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Safeguarding:</w:t></w:r><w:r><w:t xml:space="preserve"> The school counsellor is present throughout; any disclosure is handled under the school’s child protection procedure.</w:t></w:r></w:p><w:p w14:paraId="73F78023" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:bookmarkStart w:id="12" w:name="two-day-programme-schedule"/><w:bookmarkEnd w:id="11"/><w:r><w:t>6. Two-Day Programme Schedule</w:t></w:r></w:p><w:p w14:paraId="78FBC00A" w14:textId="67335711" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="FirstParagraph"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Structure:</w:t></w:r><w:r><w:t xml:space="preserve"> Day 1 is a student learning day delivered </w:t></w:r><w:r w:rsidR="00D05A30"><w:t>in the school</w:t></w:r><w:r><w:t>. Day 2 is Parents’ Day, with a parent workshop, a joint parent–child activity and a student showcase.</w:t></w:r></w:p><w:p w14:paraId="7E625E67" w14:textId="7B58C7B6" w:rsidR="00134F10" w:rsidRDefault="00D05A30"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:bookmarkStart w:id="13" w:name="grade-5-chromebook-component"/><w:bookmarkEnd w:id="12"/><w:r><w:t>7</w:t></w:r><w:r w:rsidR="00000000"><w:t>. Grade 5 Chromebook Component</w:t></w:r></w:p><w:p w14:paraId="1ECC971F" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="FirstParagraph"/></w:pPr><w:r><w:t>Because Grade 5 students use school Chromebooks, the programme includes:</w:t></w:r></w:p><w:p w14:paraId="29CE43EC" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="9"/></w:numPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Acceptable Use Agreement refresh:</w:t></w:r><w:r><w:t xml:space="preserve"> Students review and re-sign the school’s Chromebook / acceptable-use rules in simple language (log in only with your own account, never share passwords, use devices only for learning tasks, report anything that upsets you).</w:t></w:r></w:p><w:p w14:paraId="69108F65" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="9"/></w:numPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Account security lesson:</w:t></w:r><w:r><w:t xml:space="preserve"> Creating strong passwords, logging out of shared devices, recognising suspicious links and messages.</w:t></w:r></w:p><w:p w14:paraId="3B5A0DA7" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="9"/></w:numPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Kind collaboration online:</w:t></w:r><w:r><w:t xml:space="preserve"> Rules for comments in shared documents, class chats or learning platforms; consequences of misuse under the school’s discipline policy.</w:t></w:r></w:p><w:p w14:paraId="08CA9218" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="9"/></w:numPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Digital Citizen Licence:</w:t></w:r><w:r><w:t xml:space="preserve"> A short online quiz on the Chromebooks; students who pass receive a certificate presented on Day 2.</w:t></w:r></w:p><w:p w14:paraId="5E534EB3" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="9"/></w:numPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Parent briefing (Day 2):</w:t></w:r><w:r><w:t xml:space="preserve"> How the school manages devices and filtering, what students can and cannot access, and how parents can reinforce the same rules at home.</w:t></w:r></w:p><w:p w14:paraId="3CFF1AC5" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="FirstParagraph"/></w:pPr><w:r><w:rPr><w:i/><w:iCs/></w:rPr><w:lastRenderedPageBreak/><w:t>Action for ICT before the programme:</w:t></w:r><w:r><w:t xml:space="preserve"> confirm that content filtering, safe search and student account settings on the school’s device management console are up to date.</w:t></w:r></w:p><w:p w14:paraId="21B2C711" w14:textId="4CC6EAAD" w:rsidR="00134F10" w:rsidRDefault="00D05A30"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:bookmarkStart w:id="14" w:name="parent-workshop-content-day-2"/><w:bookmarkEnd w:id="13"/><w:r><w:t>8</w:t></w:r><w:r w:rsidR="00000000"><w:t>. Parent Workshop Content (Day 2)</w:t></w:r></w:p><w:p w14:paraId="628BA64C" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="10"/></w:numPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Understanding the risk at this age:</w:t></w:r><w:r><w:t xml:space="preserve"> online games with chat, group messaging, comment sections, video apps, and why age limits matter (most social platforms require users to be 13+).</w:t></w:r></w:p><w:p w14:paraId="2277AA9F" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="10"/></w:numPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Warning signs:</w:t></w:r><w:r><w:t xml:space="preserve"> a child becoming upset after device use, hiding screens, avoiding school or friends, sudden changes in mood or sleep; and signs a child may be bullying others.</w:t></w:r></w:p><w:p w14:paraId="63D956A6" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="10"/></w:numPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>How to respond:</w:t></w:r><w:r><w:t xml:space="preserve"> stay calm, listen, do not blame, do not immediately confiscate the device, save evidence (screenshots), inform the class teacher.</w:t></w:r></w:p><w:p w14:paraId="23DE03AF" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="10"/></w:numPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Practical settings clinic:</w:t></w:r><w:r><w:t xml:space="preserve"> parental controls on Android and iOS, YouTube Kids, game chat restrictions, WhatsApp privacy and group settings, screen-time limits.</w:t></w:r></w:p><w:p w14:paraId="17402133" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="10"/></w:numPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Role-modelling:</w:t></w:r><w:r><w:t xml:space="preserve"> parents’ own online behaviour, sharing children’s photos responsibly, devices in shared family spaces.</w:t></w:r></w:p><w:p w14:paraId="12466617" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="10"/></w:numPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Reporting pathways:</w:t></w:r></w:p><w:p w14:paraId="31C73B8D" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="11"/></w:numPr></w:pPr><w:r><w:t>Class teacher / school counsellor (first step for incidents involving students)</w:t></w:r></w:p><w:p w14:paraId="434456BB" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="11"/></w:numPr></w:pPr><w:r><w:t>Report and block on the app or platform</w:t></w:r></w:p><w:p w14:paraId="2FC01ADA" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="11"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">For serious matters (threats, blackmail, sharing of private images): </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>NCCIA helpline 1799</w:t></w:r><w:r><w:t xml:space="preserve"> or </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Police 15</w:t></w:r></w:p><w:p w14:paraId="77D2EBA4" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="10"/></w:numPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Family Media Agreement:</w:t></w:r><w:r><w:t xml:space="preserve"> completed with the child during the joint session.</w:t></w:r></w:p><w:p w14:paraId="71A6F999" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="FirstParagraph"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Take-home pack (English and Urdu):</w:t></w:r><w:r><w:t xml:space="preserve"> one-page tips sheet, parental control quick guide, Family Media Agreement, school reporting contacts.</w:t></w:r></w:p><w:p w14:paraId="626F965E" w14:textId="7683276E" w:rsidR="00134F10" w:rsidRDefault="00D05A30"><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:bookmarkStart w:id="15" w:name="expected-outcomes"/><w:bookmarkEnd w:id="14"/><w:r><w:t>9</w:t></w:r><w:r w:rsidR="00000000"><w:t>. Expected Outcomes</w:t></w:r></w:p><w:p w14:paraId="6DE88404" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="14"/></w:numPr></w:pPr><w:r><w:t>Students in Grades 3–5 understand cyberbullying, know how to respond, and know that they can always tell a trusted adult.</w:t></w:r></w:p><w:p w14:paraId="0C1D6E90" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="14"/></w:numPr></w:pPr><w:r><w:t>Grade 5 students use school Chromebooks safely and responsibly under a renewed acceptable-use agreement.</w:t></w:r></w:p><w:p w14:paraId="60274D5F" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="14"/></w:numPr></w:pPr><w:r><w:t>Parents are better informed, more confident with settings and supervision, and connected with the school’s reporting procedure.</w:t></w:r></w:p><w:p w14:paraId="5ED02527" w14:textId="77777777" w:rsidR="00134F10" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Compact"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="14"/></w:numPr></w:pPr><w:r><w:t>The school has a repeatable programme that can be run annually and extended to other grades.</w:t></w:r><w:bookmarkEnd w:id="15"/></w:p><w:sectPr w:rsidR="00134F10" w:rsidSect="00D05A30"><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="709" w:right="720" w:bottom="720" w:left="720" w:header="720" w:footer="720" w:gutter="0"/><w:cols w:space="720"/><w:docGrid w:linePitch="326"/></w:sectPr></w:body></w:document>